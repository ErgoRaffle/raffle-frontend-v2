{
  "$schema": "https://biomejs.dev/schemas/2.5.4/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "ignoreUnknown": false,
    "includes": ["**", "!apps/raffle/src/lib/createServerHook.ts"]
  },
  "formatter": {
    "enabled": true,
    "lineWidth": 100,
    "indentStyle": "space",
    "indentWidth": 2
  },
  "linter": {
    "enabled": true,
    "rules": {
      "a11y": {
        "noSvgWithoutTitle": "off"
      },
      "complexity": {
        "noUselessCatch": "error",
        "noUselessCatchBinding": "error",
        "noUselessFragments": "error",
        "noUselessRename": "error",
        "noUselessStringConcat": "error",
        "noUselessSwitchCase": "error",
        "noUselessTernary": "error",
        "noUselessUndefined": "error",
        "noUselessUndefinedInitialization": "error",
        "useArrayFind": "error",
        "useArrowFunction": "error",
        "useOptionalChain": "error"
      },
      "correctness": {
        "noGlobalDirnameFilename": "error",
        "noNestedComponentDefinitions": "error",
        "noNextAsyncClientComponent": "error",
        "noReactPropAssignments": "error",
        "noUnusedFunctionParameters": "error",
        "noUnusedImports": "error",
        "noUnusedVariables": "error"
      },
      "performance": {
        "noDelete": "error",
        "noImgElement": "error"
      },
      "style": {
        "noCommonJs": "error",
        "noDescendingSpecificity": "off",
        "noExportedImports": "error",
        "noNegationElse": "error",
        "noNonNullAssertion": "error",
        "noUselessElse": "error",
        "useAtIndex": "error",
        "useCollapsedElseIf": "error",
        "useCollapsedIf": "error",
        "useConsistentArrowReturn": "error",
        "useConsistentCurlyBraces": "error",
        "useConsistentObjectDefinitions": "error",
        "useConst": "error",
        "useDefaultParameterLast": "error",
        "useExponentiationOperator": "error",
        "useExportType": "error",
        "useFilenamingConvention": {
          "level": "error",
          "options": {
            "strictCase": false,
            "filenameCases": ["camelCase"]
          }
        },
        "useForOf": "error",
        "useGroupedAccessorPairs": "error",
        "useImportType": "error",
        "useNodejsImportProtocol": "error",
        "useReactFunctionComponents": "error",
        "useSelfClosingElements": "error",
        "useShorthandAssign": "error",
        "useShorthandFunctionType": "error",
        "useSingleVarDeclarator": "error",
        "useTemplate": "error",
        "useThrowNewError": "error",
        "useThrowOnlyError": "error"
      },
      "suspicious": {
        "noAlert": "error",
        "noCatchAssign": "error",
        "noConsole": "error",
        "noDeprecatedImports": "error",
        "noEmptyBlockStatements": "error",
        "noEqualsToNull": "error",
        "noEvolvingTypes": "error",
        "noExplicitAny": "error",
        "noIrregularWhitespace": "error",
        "noLeakedRender": "error",
        "noReactForwardRef": "error",
        "noUnknownAttribute": "error",
        "noUnnecessaryConditions": "error",
        "noVar": "error",
        "useArraySortCompare": "error",
        "useGuardForIn": "error",
        "useIsArray": "error"
      }
    },
    "domains": {
      "next": "recommended",
      "react": "recommended"
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "quoteProperties": "asNeeded",
      "trailingCommas": "none"
    }
  },
  "assist": {
    "enabled": true,
    "actions": {
      "source": {
        "useSortedPackageJson": "on",
        "organizeImports": {
          "level": "on",
          "options": {
            "sortBareImports": true,
            "groups": [
              ":NODE:",
              ":BLANK_LINE:",

              ["react", "react/**"],
              ["next", "next/**"],
              ":BLANK_LINE:",

              [":PACKAGE:", "!@ergo-raffle/**"],
              ":BLANK_LINE:",

              "@ergo-raffle/**",
              ":BLANK_LINE:",

              ":ALIAS:",
              ":BLANK_LINE:",

              ":PATH:",
              ":BLANK_LINE:",

              ":STYLE:",
              ":BLANK_LINE:"
            ]
          }
        }
      }
    }
  },
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  },
  "overrides": [
    {
      "includes": [
        "apps/raffle/src/{app,components,features,providers}/**/*.tsx",
        "apps/raffle/src/instrumentation-client.ts",
        "apps/raffle/next-env.d.ts",

        "packages/ui-kit/src/{components,providers}/**/*.tsx",

        "packages/icons/lib/vite-env.d.ts"
      ],
      "linter": {
        "rules": {
          "style": {
            "useFilenamingConvention": "off"
          }
        }
      }
    }
  ]
}
